}

@article{schelskeInsuringNaturalEcosystems2021,
  title = {Insuring Natural Ecosystems as an Innovative Conservation Funding Mechanism: A Case Study on Coral Reefs},
  shorttitle = {Insuring Natural Ecosystems as an Innovative Conservation Funding Mechanism},
  journal = {Handbook of Disaster Risk Reduction for Resilience},
  author = {Schelske, Oliver and Bohn, Jeffrey R. and Fitzgerald, Corinne},
