@article{nakhmurinaFiscalImpactBiodiversity2025,
  title = {The {Fiscal Impact} of {Biodiversity Loss} and a {Pathway} for {Conservation Finance}},
  author = {Nakhmurina, Anya and Manning, Dale T and Fenichel, Eli P},
  year = {2025},
  journal = {Yale University Working Paper},
  abstract = {There is burgeoning interest in ‘biodiversity and conservation finance.’ To finance conservation, there must be a cash flow to repay investors. While it is understood that natural capital contributes to economic production and human well-being, the question for biodiversity finance is to whom do conservation actions capitalize financially? Here, we argue that environmental economists can contribute to policy decisions by connecting changes in natural capital to public sector finances, where biodiversity improvements can capitalize through increased tax revenues. We show that there are opportunities for fiscal returns from investments in bat conservation, capitalized through tax revenue. The loss of bats, which provide a free pest control service for agricultural producers, results in a decrease in county property tax revenues by an average of \$1.2 million dollars per year, or 3.8\% of average property tax revenues. Econometric estimates are robust to the use of an event study and methods to estimate treatment effects with staggered timing across observations.  These results suggest that local government finances may benefit from investments in maintaining or enhancing unpriced natural capital. This means that financing conservation at the local government level can provide positive returns to conservation investment.},
  file = {/Users/a5creel/Zotero/storage/NXJG68ML/Natural Capital and Local Government Income v3.docx}
}

@article{leeExtremeTemperaturesAdaptation2025,
